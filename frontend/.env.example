# TBM Frontend Environment Variables Example
# Copy this file to .env for local development: cp .env.example .env

# Backend API base URL.
# - In local dev with Vite proxy: leave empty ("") to proxy /api requests to http://localhost:8080
# - In standalone or direct access: specify the backend URL (e.g. http://localhost:8080 or https://<backend-cloud-run-url>)
VITE_API_URL=http://localhost:8080
