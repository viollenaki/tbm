# GCP Cloud SQL & Cloud Run Production Environment Variables (Example)
# DO NOT store real production secrets in this file. Copy to .env.production and fill in real values.

GCP_PROJECT=eco-charge-kg
GCP_REGION=europe-west1
CLOUD_SQL_INSTANCE=tbm-db

POSTGRES_DB=tbm_vouchers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_production_password_here

# Cloud SQL Unix Socket Connection URL for Cloud Run
DATABASE_URL=postgres://postgres:your_production_password_here@localhost/tbm_vouchers?host=/cloudsql/eco-charge-kg:europe-west1:tbm-db

# Cloud Run Service URLs
BACKEND_URL=https://tbm-backend-622922716898.europe-west1.run.app
FRONTEND_URL=https://tbm-frontend-622922716898.europe-west1.run.app

# Backend configuration
RUST_LOG=info,backend=debug
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=30
